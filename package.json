    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Void-LifeStream/dsh-gemini-kitten-widget.git"
  },
  "homepage": "https://github.com/Void-LifeStream/dsh-gemini-kitten-widget#readme",
  "bugs": {
    "url": "https://github.com/Void-LifeStream/dsh-gemini-kitten-widget/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
